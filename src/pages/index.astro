---
/**
 * index.astro — Home page
 * Composes all section components inside the base layout.
 * Each component is self-contained (markup + scoped styles + script).
 */
import Layout from "@layouts/Layout.astro";
import Navbar from "@sections/Navbar.astro";
import Hero from "@sections/Hero.astro";
import Servicios from "@sections/Servicios.astro";
import Auditoria from "@sections/Auditoria.astro";
import Tienda from "@sections/Tienda.astro";
import Nosotras from "@sections/Nosotras.astro";
import Resenas from "@sections/Resenas.astro";
import Contacto from "@sections/Contacto.astro";
import Footer from "@sections/Footer.astro";
import BotonFlotante from "@ui/BotonFlotante.astro";
import MarqueeDivider from "@ui/MarqueeDivider.astro";
import CheckerDivider from "@ui/CheckerDivider.astro";
import { whatsappUrl } from "@data/dataSite";
---

<Layout>
  <Navbar />
  <!-- Antes del <main> para que el teclado lo alcance: al final de la
       página queda oculto porque el footer está visible. -->
  <BotonFlotante whatsappUrl={whatsappUrl} />
  <main id="main">
    <Hero />
    <MarqueeDivider variante="cruzado" />
    <Servicios />
    <CheckerDivider />
    <Auditoria />
    <CheckerDivider />
    <Resenas />
    <MarqueeDivider variante="verde" />
    <Nosotras />
    <CheckerDivider />
    <Tienda />
    <MarqueeDivider variante="rosa" />
    <CheckerDivider />
    <Contacto />
  </main>
  <Footer />
</Layout>
