---
/**
 * Página TEMPORAL de revisión de componentes (Paso 3 del rediseño).
 * Se elimina en el Paso 6. No se llama _componentes.astro porque Astro no
 * genera rutas para archivos con "_" adelante.
 * Hover, presionado y foco se prueban en vivo (mouse / Tab); acá se muestran
 * fijos solo los estados que dependen de atributos.
 */
import Layout from "@layouts/Layout.astro";
import Button from "@ui/Button.astro";
import IconButton from "@ui/IconButton.astro";
import Tag from "@ui/Tag.astro";
import BadgeSection from "@ui/BadgeSection.astro";
import ListItem from "@ui/ListItem.astro";
import Stars from "@ui/Stars.astro";
import ReviewCard from "@ui/ReviewCard.astro";
import ContactCard from "@ui/ContactCard.astro";
import Sticker from "@ui/Sticker.astro";
import Marquee from "@ui/Marquee.astro";
import CheckerDivider from "@ui/CheckerDivider.astro";
import GridBackground from "@ui/GridBackground.astro";
import NavLink from "@ui/NavLink.astro";
import MenuButton from "@ui/MenuButton.astro";
import MobileMenuLink from "@ui/MobileMenuLink.astro";
import CarouselDot from "@ui/CarouselDot.astro";
import TextLink from "@ui/TextLink.astro";
import SocialButton from "@ui/SocialButton.astro";
import BotonFlotante from "@ui/BotonFlotante.astro";
import Icon from "@ui/Icon.astro";
import type { IconName } from "@ui/iconTypes";
import {
  clientReviews,
  contactChannels,
  navLinks,
  servicios,
  instagramUrl,
  tiktokUrl,
  whatsappUrl,
  contactEmailUrl,
  carouselLabels,
} from "@data/dataSite";

const iconos: IconName[] = [
  "check",
  "arrow-right",
  "external",
  "chevron-left",
  "chevron-right",
  "menu",
  "mail",
  "instagram",
  "shopping-bag",
  "chart",
  "rocket",
  "info",
  "smile",
  "bulb",
  "pulse",
  "people",
  "heart",
  "clock",
  "pin",
  "star",
  "whatsapp",
  "tiktok",
  "close",
  "sparkle",
];
const stickers = [
  "destellos",
  "corazon",
  "cursor",
  "burbuja",
  "estrella",
  "grafico",
  "hoja",
] as const;
const estilos = ["primario", "secundario", "verde"] as const;
const resenaCorta = clientReviews[3];
const resenaLarga = clientReviews[5];
const resenaMedia = clientReviews[0];
const items = servicios[0]?.items.slice(0, 3) ?? [];
---

<Layout title="Componentes — revisión">
  <main id="main" class="demo">
    <div class="container demo__stack">
      <h1 class="section-title">Componentes <span>Dúo</span></h1>

      <section class="demo__bloque">
        <h2 class="text-h3">Íconos</h2>
        <div class="demo__fila">
          {
            iconos.map((n) => (
              <span title={n}>
                <Icon name={n} />
              </span>
            ))
          }
        </div>
      </section>

      <section class="demo__bloque">
        <h2 class="text-h3">Botón — Default / Deshabilitado</h2>
        {
          estilos.map((e) => (
            <div class="demo__fila">
              <Button estilo={e} href="#">
                {servicios[0]?.title}
              </Button>
              <Button estilo={e}>{servicios[1]?.title}</Button>
              <Button estilo={e} deshabilitado>
                {servicios[2]?.title}
              </Button>
            </div>
          ))
        }
        <div class="demo__fila demo__panel-verde">
          <Button estilo="sobre-verde" href="#">{servicios[0]?.title}</Button>
          <Button estilo="sobre-verde" deshabilitado>
            {servicios[1]?.title}
          </Button>
        </div>
      </section>

      <section class="demo__bloque">
        <h2 class="text-h3">Botón icono · Indicador carrusel</h2>
        <div class="demo__fila">
          <IconButton
            direccion="anterior"
            aria-label={carouselLabels.anterior}
          />
          <IconButton
            direccion="siguiente"
            aria-label={carouselLabels.siguiente}
          />
          <IconButton
            direccion="anterior"
            aria-label={carouselLabels.anterior}
            deshabilitado
          />
          <IconButton
            direccion="siguiente"
            aria-label={carouselLabels.siguiente}
            deshabilitado
          />
          <CarouselDot aria-label={carouselLabels.irAPagina(1)} activo />
          <CarouselDot aria-label={carouselLabels.irAPagina(2)} />
          <CarouselDot aria-label={carouselLabels.irAPagina(3)} />
        </div>
      </section>

      <section class="demo__bloque">
        <h2 class="text-h3">Tag · Badge sección · Estrellas · Item de lista</h2>
        <div class="demo__fila">
          <Tag>{navLinks[0]?.label}</Tag>
          <BadgeSection>{navLinks[1]?.label}</BadgeSection>
          <BadgeSection tono="rosa">{navLinks[2]?.label}</BadgeSection>
          <Stars rating={5} />
        </div>
        <div class="demo__fila">
          <ul class="demo__lista">
            {items.map((i) => <ListItem>{i}</ListItem>)}
          </ul>
          <ul class="demo__lista demo__panel-verde">
            {items.map((i) => <ListItem tono="claro">{i}</ListItem>)}
          </ul>
        </div>
      </section>

      <section class="demo__bloque">
        <h2 class="text-h3">Card reseña — Completa / Recortada (Leer más)</h2>
        <div class="grid">
          {
            [resenaCorta, resenaMedia, resenaLarga].map(
              (r, i) =>
                r && (
                  <ReviewCard
                    class="span-t-4 span-d-4"
                    id={`demo-resena-${i}`}
                    nombre={r.name}
                    texto={r.text}
                    rating={r.rating}
                  />
                ),
            )
          }
        </div>
      </section>

      <section class="demo__bloque">
        <h2 class="text-h3">Card contacto</h2>
        <div class="grid">
          {
            contactChannels.map((c) => (
              <ContactCard
                class="span-t-4 span-d-3"
                href={c.href}
                canal={c.name}
                descripcion={c.description}
                icono={c.icon}
                externo={c.externo}
                destacada={c.destacado}
              />
            ))
          }
        </div>
      </section>

      <section class="demo__bloque">
        <h2 class="text-h3">Stickers</h2>
        <div class="demo__fila demo__fila--stickers">
          {
            stickers.map((t, i) => (
              <Sticker tipo={t} rotacion={i % 2 ? -10 : 10} />
            ))
          }
        </div>
      </section>

      <section class="demo__bloque">
        <h2 class="text-h3">Navegación</h2>
        <div class="demo__fila">
          {
            navLinks.slice(0, 4).map((l, i) => (
              <NavLink href={l.href} activo={i === 1}>
                {l.label}
              </NavLink>
            ))
          }
        </div>
        <div class="demo__fila">
          <MenuButton controls="demo-menu" />
          <MenuButton controls="demo-menu" abierto />
        </div>
        <div class="demo__menu" id="demo-menu">
          {
            navLinks.slice(0, 3).map((l, i) => (
              <MobileMenuLink href={l.href} activo={i === 0}>
                {l.label}
              </MobileMenuLink>
            ))
          }
        </div>
        <div class="demo__fila">
          {
            navLinks
              .slice(0, 3)
              .map((l) => <TextLink href={l.href}>{l.label}</TextLink>)
          }
        </div>
        <div class="demo__fila demo__panel-oscuro">
          {
            navLinks.slice(0, 3).map((l) => (
              <TextLink href={l.href} tono="verde">
                {l.label}
              </TextLink>
            ))
          }
          <SocialButton
            href={instagramUrl}
            icono="instagram"
            label="Instagram"
          />
          <SocialButton href={tiktokUrl} icono="tiktok" label="TikTok" />
          <SocialButton href={whatsappUrl} icono="whatsapp" label="WhatsApp" />
          <SocialButton
            href={contactEmailUrl}
            icono="mail"
            label="Email"
            externo={false}
          />
        </div>
      </section>
    </div>

    <section class="demo__bloque">
      <h2 class="text-h3 container">Decorativos</h2>
      <Marquee />
      <Marquee tono="rosa" />
      <CheckerDivider />
      <div class="section demo__grilla">
        <GridBackground />
        <p class="container section-subtitle">Patrón/Grilla 48px</p>
      </div>
    </section>
  </main>
  <BotonFlotante />
</Layout>

<style>
  .demo {
    padding-block: var(--duo-space-10);
  }

  .demo__stack {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-9);
  }

  .demo__bloque {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-6);
  }

  .demo__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--duo-space-4);
  }

  .demo__fila--stickers {
    gap: var(--duo-space-7);
  }

  .demo__lista {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-2);
    padding: var(--duo-space-4);
  }

  .demo__panel-verde {
    padding: var(--duo-space-6);
    border-radius: var(--duo-radius-md);
    background: var(--duo-bg-hero);
  }

  .demo__panel-oscuro {
    padding: var(--duo-space-6);
    border-radius: var(--duo-radius-md);
    background: var(--duo-bg-inverse);
  }

  .demo__menu {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-2);
    max-width: 350px;
  }

  .demo__grilla {
    background: var(--duo-bg-page);
  }
</style>
