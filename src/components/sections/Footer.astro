---
/**
 * Footer — Figma: desktop 23:394 · tablet 54:2699 · mobile 27:689.
 * Nota de cumplimiento: "Nota/Footer".
 * - Desktop: marca 5 col + navegación 3 col + conectemos 4 col; legal con
 *   "Volver arriba". Tablet/mobile: marca arriba y links en 2 columnas.
 * - Mismos links y orden que el navbar (+ Contacto), con 44px de área.
 * - Íconos sociales de 48px con aria-label ("Instagram de Dúo").
 */
import { Image } from "astro:assets";
import TextLink from "@ui/TextLink.astro";
import SocialButton from "@ui/SocialButton.astro";
import Icon from "@ui/Icon.astro";
import isotipoD from "@images/isotipo-d-cursor.png";
import {
  navLinks,
  contactoLink,
  socialLinks,
  footerSeccion as f,
  ubicacion,
  contactEmail,
  contactEmailUrl,
} from "@data/dataSite";

const links = [...navLinks, contactoLink];
const mitad = Math.ceil(links.length / 2);
const columnas = [links.slice(0, mitad), links.slice(mitad)];
const anio = new Date().getFullYear();
---

<footer class="footer" data-footer>
  <div class="container footer__cuerpo">
    <div class="footer__columnas">
      <div class="footer__marca">
        <div class="footer__logo">
          <span class="footer__d" aria-hidden="true">
            <Image src={isotipoD} alt="" widths={[120, 240]} sizes="70px" />
          </span>
          <p class="footer__nombre">{f.marca}</p>
        </div>
        <p class="footer__tagline">{f.tagline}</p>
        <p class="footer__ubicacion">
          <Icon name="pin" size={18} />
          {ubicacion}
        </p>
      </div>

      <div class="footer__bloques">
        <nav class="footer__nav" aria-label={f.navAriaLabel}>
          <p class="footer__etiqueta">{f.navLabel}</p>
          <div class="footer__links">
            {
              columnas.map((col) => (
                <ul class="footer__columna-links">
                  {col.map((link) => (
                    <li>
                      <TextLink href={link.href} tono="verde">
                        {link.label}
                      </TextLink>
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </nav>

        <div class="footer__conectemos">
          <p class="footer__etiqueta">{f.conectemos}</p>
          <ul class="footer__sociales">
            {
              socialLinks.map((s) => (
                <li>
                  <SocialButton
                    href={s.href}
                    icono={s.icon}
                    label={s.label}
                    externo={s.external}
                    fondo={s.fondo}
                  />
                </li>
              ))
            }
          </ul>
          <a class="footer__email" href={contactEmailUrl}>{contactEmail}</a>
        </div>
      </div>
    </div>

    <hr class="footer__divisor" />

    <div class="footer__legal">
      <p class="footer__copyright">{f.copyright(anio)}</p>
      <a class="footer__arriba" href="#">
        {f.volverArriba}
        <Icon name="arrow-right" size={16} class="footer__arriba-icono" />
      </a>
    </div>
  </div>
</footer>

<style>
  /* ---------- Estructura (mobile first) ---------- */
  .footer {
    --duo-focus-color: var(--duo-border-focus-inverse);
    padding-block: var(--duo-space-8) var(--duo-space-7); /* 48 / 32 */
    background: var(--duo-bg-inverse);
    color: var(--duo-text-inverse);
  }

  .footer__cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-7);
  }

  .footer__columnas,
  .footer__bloques {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-7);
  }

  /* ---------- Marca ---------- */
  .footer__marca {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-7);
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: var(--duo-space-3);
  }

  /* D crema de 60×40, recortada como en Figma */
  .footer__d {
    position: relative;
    flex-shrink: 0;
    width: 60px;
    height: 40px;
    overflow: hidden;
  }

  .footer__d :global(img) {
    position: absolute;
    top: -73.17%;
    left: -6.98%;
    width: 116.28%;
    height: 243.9%;
    max-width: none;
  }

  .footer__nombre {
    font-size: var(--duo-fs-h3);
    font-weight: 700;
    line-height: 1.3;
  }

  .footer__tagline {
    font-size: var(--duo-fs-body-s);
    line-height: 1.6;
  }

  /* Ubicación, email y "Volver arriba": solo desktop (Figma) */
  .footer__ubicacion,
  .footer__email,
  .footer__arriba {
    display: none;
  }

  /* ---------- Navegación y redes ---------- */
  .footer__etiqueta {
    font-size: var(--duo-fs-eyebrow);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--duo-text-highlight);
  }

  .footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--duo-space-4);
  }

  .footer__columna-links {
    display: flex;
    flex-direction: column;
    list-style: none;
  }

  .footer__conectemos {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-3);
  }

  .footer__sociales {
    display: flex;
    gap: var(--duo-space-3);
    list-style: none;
  }

  .footer__divisor {
    width: 100%;
    height: 1px;
    border: 0;
    background: var(--duo-border-inverse);
    opacity: 0.2;
  }

  .footer__legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--duo-space-4);
    font-size: var(--duo-fs-caption);
    line-height: 1.5;
  }

  /* ---------- Tablet (768–1023): navegación y redes en la misma fila ---------- */
  @media (min-width: 768px) {
    .footer__bloques {
      flex-direction: row;
      gap: var(--duo-space-6);
    }

    .footer__nav {
      flex: 0 0 calc(50% - var(--duo-space-6) / 2);
    }
  }

  /* ---------- Desktop (≥1024): 5 + 3 + 4 columnas ---------- */
  @media (min-width: 1024px) {
    .footer {
      padding-top: var(--duo-space-9); /* 64 */
    }

    .footer__cuerpo {
      gap: var(--duo-space-8);
    }

    .footer__columnas {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--duo-grid-gutter);
    }

    .footer__marca {
      grid-column: span 5;
      gap: var(--duo-space-4);
    }

    .footer__tagline {
      max-width: 360px;
    }

    .footer__ubicacion {
      display: inline-flex;
      align-items: center;
      gap: var(--duo-space-2);
      font-size: var(--duo-fs-caption);
      line-height: 1.5;
    }

    .footer__ubicacion :global(svg) {
      color: var(--duo-text-highlight);
    }

    .footer__bloques {
      display: contents;
    }

    .footer__nav {
      display: flex;
      flex-direction: column;
      gap: var(--duo-space-1);
      grid-column: span 3;
    }

    /* En desktop los 6 links van en una sola columna, con 4px entre sí */
    .footer__links,
    .footer__columna-links {
      display: flex;
      flex-direction: column;
      gap: var(--duo-space-1);
    }

    .footer__conectemos {
      grid-column: span 4;
      gap: var(--duo-space-4);
    }

    /* Área táctil de 44px (CLAUDE.md) */
    .footer__email {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      min-height: 44px;
      font-size: var(--duo-fs-body-s);
      line-height: 1.6;
      text-underline-offset: 0.2em;
    }

    .footer__email:hover,
    .footer__arriba:hover {
      text-decoration: underline;
    }

    .footer__arriba {
      display: inline-flex;
      align-items: center;
      gap: var(--duo-space-2);
      min-height: 44px;
      text-underline-offset: 0.2em;
    }

    .footer__arriba :global(.footer__arriba-icono) {
      transform: rotate(-90deg);
    }
  }
</style>
