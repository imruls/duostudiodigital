---
import { shopFeatures as features, shopHref } from "@data/dataSite";
import Icon from "@ui/Icon.astro";
import type { IconName } from "@ui/iconTypes";
---

<section class="shop" id="shop">
  <div class="container shop__grid">
    <div class="shop__content reveal">
      <span class="section-label shop__label">Nuestra Tienda</span>
      <h2 class="section-title shop__title">
        Visitá nuestro <span>eshop</span>
      </h2>
      <p class="shop__desc">
        Encontrá recursos, plantillas y productos digitales pensados para
        ayudarte a crecer en redes sin perder tiempo empezando de cero.
      </p>

      <div class="shop__features">
        {
          features.map((f) => (
            <div class="shop__feature">
              <div class="shop__feature-icon">
                <Icon name={f.icon as IconName} />
              </div>
              <span class="shop__feature-text">{f.text}</span>
            </div>
          ))
        }
      </div>

      <a
        href={shopHref}
        target="_blank"
        rel="noopener noreferrer"
        class="shop__cta"
      >
        Ir a la tienda
        <Icon name="shopping-bag" />
      </a>
    </div>
  </div>
</section>

<style>
  .shop {
    padding: var(--duo-space-10) 0;
    background: linear-gradient(
      to bottom,
      var(--duo-action-primary-bg),
      var(--duo-bg-cream)
    );
    position: relative;
    overflow: hidden;
    contain: paint;
  }

  .shop::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -30%;
    width: 80vw;
    height: 80vw;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--duo-color-crema-50) 5%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .shop__grid {
    display: flex;
    justify-content: center;
  }

  .shop__content {
    text-align: center;
    max-width: 620px;
  }

  .shop__label {
    color: var(--duo-text-accent);
  }

  .shop__label::before {
    background: var(--duo-action-secondary-bg);
  }

  .shop__title {
    color: var(--duo-text-primary);
  }

  .shop__title span {
    color: var(--duo-text-accent);
  }

  .shop__desc {
    font-size: 1rem;
    color: var(--duo-text-primary);
    line-height: 1.7;
    margin: 0 auto var(--duo-space-7);
  }

  .shop__features {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--duo-space-4);
    margin-bottom: var(--duo-space-7);
    text-align: left;
  }

  .shop__feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--duo-color-verde-900) 5%, transparent);
    border-radius: var(--duo-radius-md);
  }

  .shop__feature-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--duo-radius-sm);
    background: color-mix(in srgb, var(--duo-color-verde-700) 15%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .shop__feature-icon svg {
    width: 18px;
    height: 18px;
    color: var(--duo-text-primary);
  }

  .shop__feature-text {
    font-size: 0.9rem;
    color: var(--duo-text-primary);
  }

  .shop__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background: var(--duo-action-secondary-bg);
    color: var(--duo-text-inverse);
    border-radius: var(--duo-radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    transition: var(--duo-transition);
    box-shadow: 0 4px 20px
      color-mix(in srgb, var(--duo-color-verde-700) 30%, transparent);
  }

  .shop__cta:hover {
    background: var(--duo-color-verde-800);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px
      color-mix(in srgb, var(--duo-color-verde-700) 40%, transparent);
  }

  @media (min-width: 640px) {
    .shop__features {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
