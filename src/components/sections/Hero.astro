---
/**
 * Hero — Figma: desktop 19:51 · tablet 54:2455 · mobile 24:396.
 * Nota de cumplimiento: "Nota/Hero".
 * - Desktop: texto 7 col + visual 5 col. Tablet/mobile: apilado.
 * - Rosa solo en la palabra en Pacifico y el CTA principal (Von Restorff).
 * - Prueba social visible desde el inicio (posición serial).
 * - Foto con alt descriptivo; sello, chip decorativo y stickers aria-hidden.
 */
import { Image } from "astro:assets";
import Button from "@ui/Button.astro";
import Stars from "@ui/Stars.astro";
import Sticker from "@ui/Sticker.astro";
import Icon from "@ui/Icon.astro";
import foto from "@images/foto-cami-y-mica.jpg";
import sello from "@images/sello-duo-studio-digital.png";
import { hero, googleRatingResumen, fundadorasLabel } from "@data/dataSite";
---

<section class="hero" id="hero">
  <div class="container hero__contenido">
    <div class="hero__stickers-desktop" aria-hidden="true">
      <Sticker
        tipo="hoja"
        tamano={44.8}
        rotacion={20}
        class="hero__st hero__st--hoja"
      />
      <Sticker
        tipo="destellos"
        tamano={61.6}
        rotacion={8}
        class="hero__st hero__st--destellos"
      />
      <Sticker
        tipo="corazon"
        tamano={67.2}
        rotacion={12}
        class="hero__st hero__st--corazon"
      />
      <Sticker
        tipo="cursor"
        tamano={56}
        rotacion={-8}
        class="hero__st hero__st--cursor"
      />
      <Sticker
        tipo="estrella"
        tamano={61.6}
        rotacion={-10}
        class="hero__st hero__st--estrella"
      />
    </div>

    <div class="hero__copy">
      <p class="hero__badge">{hero.badge}</p>

      <h1 class="hero-title hero__titulo">
        {hero.titulo.antes}<span>{hero.titulo.destacado}</span>{
          hero.titulo.despues
        }
      </h1>

      <p class="hero__bajada">{hero.bajada}</p>

      <div class="hero__ctas">
        <Button href={hero.ctaPrincipal.href} class="hero__cta">
          {hero.ctaPrincipal.label}
        </Button>
        <Button
          href={hero.ctaSecundario.href}
          estilo="sobre-verde"
          icono={null}
          class="hero__cta"
        >
          {hero.ctaSecundario.label}
        </Button>
      </div>

      <ul class="hero__prueba">
        <li class="hero__dato">
          <Stars rating={5} tono="claro" mostrarTexto={false} />
          <span>{googleRatingResumen}</span>
        </li>
        <li class="hero__separador" aria-hidden="true"></li>
        <li class="hero__dato">
          <Icon name="whatsapp" size={18} />
          <span>{hero.respuestaRapida}</span>
        </li>
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__foto">
        <Image
          src={foto}
          alt={hero.fotoAlt}
          widths={[320, 420, 640, 840]}
          sizes="(min-width: 1024px) 420px, (min-width: 768px) 320px, 280px"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="hero__sello" aria-hidden="true">
        <span class="hero__sello-recorte">
          <Image src={sello} alt="" widths={[160, 320]} sizes="160px" />
        </span>
      </div>

      <p class="hero__chip" aria-hidden="true">
        <Icon name="heart" size={18} />
        {fundadorasLabel}
      </p>
    </div>
  </div>

  <div class="hero__stickers-compacto" aria-hidden="true">
    <Sticker
      tipo="destellos"
      tamano={44.8}
      rotacion={8}
      class="hero__st hero__st--destellos-c"
    />
    <Sticker
      tipo="corazon"
      tamano={44.8}
      rotacion={12}
      class="hero__st hero__st--corazon-c"
    />
  </div>
</section>

<style>
  /* ---------- Sección (mobile first) ---------- */
  .hero {
    --duo-focus-color: var(--duo-border-focus-inverse);
    position: relative;
    overflow: clip;
    padding-block: var(--duo-space-8) var(--duo-space-9); /* 48 / 64 */
    background: var(--duo-bg-hero);
    color: var(--duo-text-inverse);
  }

  .hero__contenido {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-6);
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--duo-space-6);
  }

  /* Badge del hero: rosa, borde punteado, sin inclinar */
  .hero__badge {
    padding: var(--duo-space-2) var(--duo-space-4);
    border: var(--duo-border-thin) dashed var(--duo-border-strong);
    border-radius: var(--duo-radius-sm);
    background: var(--duo-badge-bg);
    box-shadow: var(--duo-shadow-cta);
    color: var(--duo-text-primary);
    font-size: var(--duo-fs-eyebrow);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero__bajada {
    font-size: var(--duo-fs-body);
    line-height: 1.6;
  }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-3);
    width: 100%;
  }

  .hero__ctas :global(.hero__cta) {
    width: 100%;
  }

  .hero__prueba {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-3);
    font-size: var(--duo-fs-body-s);
    line-height: 1.6;
  }

  .hero__dato {
    display: inline-flex;
    align-items: center;
    gap: var(--duo-space-2);
  }

  .hero__separador {
    display: none;
    width: 1px;
    height: 20px;
    background: var(--duo-border-inverse);
    opacity: 0.4;
  }

  /* ---------- Visual (mobile: 350×400) ---------- */
  .hero__visual {
    --foto-izq: 39.9px;
    --foto-arriba: 7px;
    --foto-ancho: 280px;
    --foto-alto: 380px;
    --sello-izq: -8.9px;
    --sello-arriba: 277.8px;
    --sello-tamano: 120px;
    position: relative;
    width: 100%;
    height: 400px;
  }

  .hero__foto {
    position: absolute;
    left: var(--foto-izq);
    top: var(--foto-arriba);
    width: var(--foto-ancho);
    height: var(--foto-alto);
    overflow: hidden;
    /* Arco: radio superior = medio ancho; inferior 24px */
    border: var(--duo-border-thick) solid var(--duo-border-strong);
    border-radius: calc(var(--foto-ancho) / 2) calc(var(--foto-ancho) / 2)
      var(--duo-radius-lg) var(--duo-radius-lg);
    box-shadow: var(--duo-shadow-card);
    transform: rotate(3deg);
  }

  .hero__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__sello {
    position: absolute;
    left: var(--sello-izq);
    top: var(--sello-arriba);
    width: var(--sello-tamano);
    height: var(--sello-tamano);
    overflow: hidden;
    border: var(--duo-border-thick) solid var(--duo-border-strong);
    border-radius: var(--duo-radius-full);
    background: var(--duo-bg-cream);
    box-shadow: var(--duo-shadow-toggle);
    transform: rotate(8deg);
  }

  /* Imagen de 140/168 (83,3%) centrada con 12,4/168 (7,4%) de margen,
     recortada igual que en Figma. */
  .hero__sello-recorte {
    position: absolute;
    top: 7.4%;
    left: 7.4%;
    width: 83.3%;
    height: 83.3%;
    overflow: hidden;
  }

  .hero__sello-recorte :global(img) {
    position: absolute;
    top: -28.13%;
    left: -5.56%;
    width: 111.11%;
    height: 156.25%;
    max-width: none;
  }

  .hero__chip {
    display: none;
  }

  /* ---------- Stickers ---------- */
  .hero__stickers-desktop {
    display: none;
  }

  .hero :global(.hero__st) {
    position: absolute;
    z-index: 2;
  }

  /* Mobile y tablet: mismos offsets desde la derecha/arriba de la sección */
  .hero :global(.hero__st--destellos-c) {
    top: 42.9px;
    right: 48.5px;
  }

  .hero :global(.hero__st--corazon-c) {
    top: 764.2px;
    right: 50.3px;
  }

  /* ---------- Tablet (768–1023) ---------- */
  @media (min-width: 768px) {
    .hero {
      padding-block: 56px calc(var(--duo-space-9) + var(--duo-space-4)); /* 56 / 80 */
    }

    .hero__ctas {
      flex-direction: row;
      gap: var(--duo-space-4);
      width: auto;
    }

    .hero__ctas :global(.hero__cta) {
      width: auto;
    }

    .hero__prueba {
      flex-direction: row;
      gap: var(--duo-space-6);
    }

    .hero__visual {
      --foto-izq: 68.5px;
      --foto-arriba: 8px;
      --foto-ancho: 320px;
      --foto-alto: 430px;
      --sello-arriba: 327.8px;
      width: 420px;
      height: 460px;
    }
  }

  /* ---------- Desktop (≥1024): 7 + 5 columnas ---------- */
  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--duo-space-10)
        calc(var(--duo-space-10) + var(--duo-space-4)); /* 96 / 112 */
    }

    .hero__contenido {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--duo-grid-gutter);
      align-items: center;
    }

    .hero__copy {
      grid-column: 1 / span 7;
      gap: var(--duo-space-7);
    }

    .hero__titulo {
      max-width: 640px;
    }

    .hero__bajada {
      max-width: 580px;
      font-size: var(--duo-fs-body-l);
      line-height: 1.7;
    }

    .hero__separador {
      display: block;
    }

    /* Visual de 486×600 en 1200px; escala con la columna en 1024–1439 */
    .hero__visual {
      grid-column: 8 / span 5;
      width: 100%;
      height: auto;
      aspect-ratio: 486 / 600;
      container-type: inline-size;
    }

    .hero__foto {
      --foto-ancho: 86.42cqw; /* 420 / 486 */
      left: 9.26cqw; /* 45 / 486 */
      top: 2.18cqw; /* 10.6 / 486 */
      height: auto;
      aspect-ratio: 3 / 4;
    }

    .hero__sello {
      left: -2.57cqw; /* -12.5 / 486 */
      top: 86.6cqw; /* 420.9 / 486 */
      width: 34.57cqw; /* 168 / 486 */
      height: 34.57cqw;
    }

    .hero__chip {
      position: absolute;
      left: 51.69cqw; /* 251.2 / 486 */
      top: 9.67cqw; /* 47 / 486 */
      display: inline-flex;
      align-items: center;
      gap: var(--duo-space-2);
      padding: var(--duo-space-3) var(--duo-space-5);
      border: var(--duo-border-thick) solid var(--duo-border-strong);
      border-radius: var(--duo-radius-full);
      background: var(--duo-bg-surface);
      box-shadow: var(--duo-shadow-cta);
      color: var(--duo-text-primary);
      font-size: var(--duo-fs-button);
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
      transform: rotate(-4deg);
    }

    .hero__stickers-desktop {
      position: absolute;
      inset: 0;
      display: block;
      pointer-events: none;
    }

    .hero__stickers-compacto {
      display: none;
    }

    /* Posiciones de Figma relativas al contenido de 1200px (left en %),
       top desde el borde superior del contenido (padding de 96px). */
    .hero :global(.hero__st--hoja) {
      left: -1.6%;
      top: -50px;
    }

    .hero :global(.hero__st--destellos) {
      left: 46.3%;
      top: 0;
    }

    .hero :global(.hero__st--corazon) {
      left: 54.4%;
      top: 40px;
    }

    .hero :global(.hero__st--cursor) {
      left: 37%;
      top: 540px;
    }

    .hero :global(.hero__st--estrella) {
      left: 94.6%;
      top: 518px;
    }
  }
</style>
