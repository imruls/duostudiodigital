---
import { Image } from "astro:assets";
import { navLinks as links } from "@data/dataSite";
import logo from "@images/5.png";
import isotipo from "@images/isotipo.png";
---

<nav class="navbar" id="navbar" aria-label="Navegación principal">
  <div class="container">
    <a href="#" class="nav-logo" aria-label="Dúo Studio Digital — Inicio">
      <Image
        src={isotipo}
        alt="Dúo Studio Digital"
        class="nav-logo__mobile"
        width={44}
        height={44}
        format="webp"
        loading="eager"
        decoding="async"
      />
      <Image
        src={logo}
        alt="Dúo Studio Digital"
        class="nav-logo__desktop"
        loading="eager"
        decoding="async"
        format="webp"
      />
    </a>

    <!-- Desktop links -->
    <div class="nav-links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>

    <a href="#contacto" class="nav-cta">Contacto</a>

    <!-- Mobile toggle -->
    <button
      class="nav-toggle"
      id="navToggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<!-- Mobile overlay -->
<div class="mobile-overlay" id="mobileOverlay" aria-hidden="true"></div>

<!-- Mobile drawer -->
<div
  class="mobile-menu"
  id="mobileMenu"
  role="dialog"
  aria-label="Menú de navegación"
>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
  <a href="#contacto" class="mobile-menu__cta">Contacto →</a>
</div>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 0.25rem 0;
    transition: var(--duo-transition);
    background: color-mix(in srgb, var(--duo-color-crema-50) 0%, transparent);
  }

  .navbar.scrolled {
    background: color-mix(in srgb, var(--duo-color-crema-50) 95%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 20px
      color-mix(in srgb, var(--duo-color-verde-900) 6%, transparent);
    padding: 0.2rem 0;
  }

  .navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    transition: var(--duo-transition);
  }

  .nav-logo__mobile {
    height: 40px;
    width: 40px;
    object-fit: contain;
    transition: var(--duo-transition);
  }

  .nav-logo__desktop {
    display: none;
    height: 60px;
    width: auto;
    transition: var(--duo-transition);
  }

  .nav-logo:hover img {
    transform: scale(1.05);
  }

  /* Desktop links */
  .nav-links {
    display: none;
    gap: 2rem;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-links a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--duo-text-primary);
    transition: var(--duo-transition);
    position: relative;
  }

  .nav-links a::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--duo-action-secondary-bg);
    transition: var(--duo-transition);
  }

  .nav-links a:hover {
    color: var(--duo-text-accent);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  /* CTA */
  .nav-cta {
    display: none;
    padding: 0.6rem 1.5rem;
    background: var(--duo-action-secondary-bg);
    color: var(--duo-text-inverse);
    border-radius: var(--duo-radius-full);
    font-size: 0.85rem;
    font-weight: 500;
    transition: var(--duo-transition);
  }

  .nav-cta:hover {
    background: var(--duo-action-secondary-bg-hover);
    transform: translateY(-1px);
  }

  /* Mobile toggle */
  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    align-items: center;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--duo-action-secondary-bg-hover);
    border-radius: 2px;
    transition: var(--duo-transition);
  }

  .nav-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .nav-toggle.active span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--duo-color-verde-900) 30%, transparent);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: var(--duo-transition);
  }

  .mobile-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile menu drawer */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 80%;
    max-width: 320px;
    height: 100vh;
    height: 100dvh;
    background: var(--duo-bg-page);
    z-index: 999;
    padding: 5rem 2rem 2rem;
    transition: var(--duo-transition);
    box-shadow: -10px 0 40px
      color-mix(in srgb, var(--duo-color-verde-900) 10%, transparent);
  }

  .mobile-menu.open {
    right: 0;
  }

  .mobile-menu a {
    display: block;
    padding: 1rem 0;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--duo-text-primary);
    border-bottom: 1px solid var(--duo-color-crema-500);
    transition: var(--duo-transition);
  }

  .mobile-menu a:hover {
    color: var(--duo-text-accent);
    padding-left: 0.5rem;
  }

  .mobile-menu__cta {
    color: var(--duo-text-accent) !important;
    font-weight: 600 !important;
    border-bottom: none !important;
    margin-top: var(--duo-space-4);
  }

  /* Desktop breakpoint */
  @media (min-width: 1024px) {
    .nav-logo__mobile {
      display: none;
    }

    .nav-logo__desktop {
      display: block;
      height: 80px;
    }

    .nav-links {
      display: flex;
    }
    .nav-cta {
      display: inline-flex;
    }
    .nav-toggle {
      display: none;
    }
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("navToggle");
  const menu = document.getElementById("mobileMenu");
  const overlay = document.getElementById("mobileOverlay");

  if (navbar) {
    window.addEventListener(
      "scroll",
      () => {
        navbar.classList.toggle("scrolled", window.scrollY > 60);
      },
      { passive: true },
    );
  }

  if (toggle && menu && overlay) {
    // Vinculamos a nuevas const para que TypeScript retenga el narrowing
    // (no-null) dentro del closure de `toggleMenu`.
    const toggleEl = toggle;
    const menuEl = menu;
    const overlayEl = overlay;

    function toggleMenu() {
      const isOpen = menuEl.classList.contains("open");
      menuEl.classList.toggle("open");
      overlayEl.classList.toggle("open");
      toggleEl.classList.toggle("active");
      toggleEl.setAttribute("aria-expanded", String(!isOpen));
      document.body.style.overflow = isOpen ? "" : "hidden";
    }

    toggle.addEventListener("click", toggleMenu);
    overlay.addEventListener("click", toggleMenu);

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (menu.classList.contains("open")) toggleMenu();
      });
    });
  }
</script>
