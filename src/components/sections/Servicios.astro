---
/**
 * Servicios — Figma: desktop 19:95 · tablet 54:2479 · mobile 24:433.
 * Nota de cumplimiento: "Nota/Servicios".
 * - Desktop: 4 cards de 3 columnas. Tablet: grilla 2×2. Mobile: carrusel
 *   con scroll-snap (card de 300px + asomo), puntos y "Deslizá para ver más".
 * - Todo lo que incluye cada servicio está a la vista (sin acordeones).
 * - "Consultar" abre WhatsApp con aria-label propio por servicio.
 * - "¿No sabés por dónde empezar?" deriva a la Auditoría.
 */
import BadgeSection from "@ui/BadgeSection.astro";
import Tag from "@ui/Tag.astro";
import ListItem from "@ui/ListItem.astro";
import Button from "@ui/Button.astro";
import CarouselDot from "@ui/CarouselDot.astro";
import GridBackground from "@ui/GridBackground.astro";
import Sticker from "@ui/Sticker.astro";
import Icon from "@ui/Icon.astro";
import {
  servicios,
  serviciosSeccion as s,
  getWhatsappLink,
  externalLinkHint,
  carouselLabels,
} from "@data/dataSite";

const colores = ["verde", "rosa", "crema", "salvia"] as const;
const total = servicios.length;
const plantillaEstado = carouselLabels
  .estado(0, 0)
  .replace(/^0/, "{a}")
  .replace(/0$/, "{t}");
---

<section
  class="section servicios"
  id="servicios"
  aria-labelledby="servicios-titulo"
>
  <GridBackground />

  <div class="servicios__stickers" aria-hidden="true">
    <div class="container servicios__stickers-desktop">
      <div class="servicios__stickers-caja">
        <Sticker
          tipo="destellos"
          tamano={67.2}
          rotacion={10}
          class="servicios__st servicios__st--destellos"
        />
        <Sticker
          tipo="grafico"
          tamano={67.2}
          rotacion={-8}
          class="servicios__st servicios__st--grafico"
        />
        <Sticker
          tipo="corazon"
          tamano={50.4}
          rotacion={-12}
          class="servicios__st servicios__st--corazon"
        />
        <Sticker
          tipo="burbuja"
          tamano={56}
          rotacion={6}
          class="servicios__st servicios__st--burbuja"
        />
      </div>
    </div>
    <Sticker
      tipo="destellos"
      tamano={39.2}
      rotacion={-10}
      class="servicios__st servicios__st--destellos-c"
    />
    <Sticker
      tipo="grafico"
      tamano={33.6}
      rotacion={8}
      class="servicios__st servicios__st--grafico-c"
    />
  </div>

  <div class="servicios__cuerpo">
    <header class="container servicios__encabezado">
      <BadgeSection>{s.badge}</BadgeSection>
      <h2 class="section-title" id="servicios-titulo">
        {s.titulo.antes}<span>{s.titulo.destacado}</span>
      </h2>
      <p class="section-subtitle servicios__bajada">{s.bajada}</p>
    </header>

    <div class="servicios__carrusel" data-carrusel>
      <ul class="servicios__pista" data-carrusel-pista>
        {
          servicios.map((servicio, i) => (
            <li class="servicios__item">
              <article
                class:list={[
                  "servicio-card",
                  `servicio-card--${colores[i % 4]}`,
                ]}
              >
                <Tag>
                  {s.numero(i + 1)}
                  <span class="servicio-card__de">{s.deTotal(total)}</span>
                </Tag>
                <h3 class="servicio-card__titulo">{servicio.title}</h3>
                <p class="servicio-card__desc">{servicio.description}</p>
                <hr class="servicio-card__divisor" />
                <p class="servicio-card__incluye">{s.incluye}</p>
                <ul class="servicio-card__lista">
                  {servicio.items.map((item) => (
                    <ListItem>{item}</ListItem>
                  ))}
                </ul>
                <div class="servicio-card__espaciador" />
                <Button
                  estilo="verde"
                  href={getWhatsappLink(s.mensajeWhatsapp(servicio.title))}
                  icono="whatsapp"
                  externo
                  anchoCompleto
                  aria-label={`${s.consultarAria(servicio.title)} ${externalLinkHint}`}
                  class="servicio-card__cta"
                >
                  {s.consultar}
                </Button>
              </article>
            </li>
          ))
        }
      </ul>

      <div class="container servicios__indicador">
        {
          servicios.map((_, i) => (
            <CarouselDot
              aria-label={carouselLabels.irAPagina(i + 1)}
              activo={i === 0}
              data-carrusel-punto
            />
          ))
        }
        <p class="servicios__deslizar" aria-hidden="true">{s.deslizar}</p>
        <p
          class="sr-only"
          aria-live="polite"
          data-carrusel-estado
          data-plantilla={plantillaEstado}
        >
          {carouselLabels.estado(1, total)}
        </p>
      </div>
    </div>

    <div class="container">
      <a class="servicios__ayuda" href={s.ayuda.href}>
        <span class="servicios__ayuda-pregunta">{s.ayuda.pregunta}</span>
        <span class="servicios__ayuda-link">
          {s.ayuda.link}
          <Icon name="arrow-right" size={18} />
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  import { initCarrusel } from "@scripts/carousel";
  document
    .querySelectorAll<HTMLElement>(".servicios [data-carrusel]")
    .forEach(initCarrusel);
</script>

<style>
  /* ---------- Estructura (mobile first) ---------- */
  .servicios {
    background: var(--duo-bg-page);
  }

  .servicios__cuerpo {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-7);
  }

  .servicios__encabezado {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--duo-space-3);
  }

  .servicios__encabezado .section-title {
    max-width: 1100px;
  }

  /* En tablet/mobile la bajada ocupa todo el ancho (Figma: 704px) */
  .servicios__bajada {
    max-width: none;
  }

  /* ---------- Pista: carrusel en mobile, grilla desde tablet ---------- */
  .servicios__pista {
    display: flex;
    gap: var(--duo-space-4);
    margin: 0;
    /* Recorte solo horizontal y aire abajo para la sombra de 6px */
    padding: var(--duo-space-1) var(--duo-container-margin) var(--duo-space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--duo-container-margin);
    scrollbar-width: none;
    list-style: none;
  }

  .servicios__pista::-webkit-scrollbar {
    display: none;
  }

  .servicios__item {
    display: flex;
    flex: 0 0 300px;
    scroll-snap-align: start;
  }

  /* ---------- Card ---------- */
  .servicio-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--duo-space-4);
    width: 100%;
    padding: var(--duo-space-6);
    border: var(--duo-border-thick) solid var(--duo-border-strong);
    border-radius: var(--duo-radius-lg);
    box-shadow: var(--duo-shadow-card);
    color: var(--duo-text-primary);
  }

  .servicio-card--verde {
    background: var(--duo-card-verde);
  }

  .servicio-card--rosa {
    background: var(--duo-card-rosa);
  }

  .servicio-card--crema {
    background: var(--duo-card-crema);
  }

  .servicio-card--salvia {
    background: var(--duo-card-salvia);
  }

  .servicio-card__titulo {
    font-size: var(--duo-fs-h3);
    font-weight: 700;
    line-height: 1.3;
  }

  .servicio-card__desc {
    font-size: var(--duo-fs-body-s);
    line-height: 1.6;
  }

  /* El divisor solo aparece desde tablet (Figma mobile no lo tiene) */
  .servicio-card__divisor {
    display: none;
    width: 100%;
    height: 1px;
    border: 0;
    background: var(--duo-border-strong);
    opacity: 0.2;
  }

  .servicio-card__incluye {
    font-size: var(--duo-fs-eyebrow);
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--duo-text-secondary);
  }

  /* AA: text/secondary sobre card/salvia da 4,14:1 en 12px; en esa card
     el rótulo pasa a text/primary (8,11:1). */
  .servicio-card--salvia .servicio-card__incluye {
    color: var(--duo-text-primary);
  }

  .servicio-card__lista {
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-2);
    width: 100%;
    list-style: none;
  }

  /* " de 4": el espacio inicial se conserva dentro del Tag (inline-flex) */
  .servicio-card__de {
    white-space: pre;
  }

  .servicio-card__espaciador {
    flex: 1 0 0;
  }

  /* ---------- Indicador (solo mobile) ---------- */
  .servicios__indicador {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .servicios__deslizar {
    margin-left: var(--duo-space-2);
    font-size: var(--duo-fs-caption);
    line-height: 1.5;
    color: var(--duo-text-secondary);
  }

  /* ---------- Ayuda: link a la Auditoría ---------- */
  .servicios__ayuda {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--duo-space-1);
    padding: var(--duo-space-4) var(--duo-space-5);
    border: var(--duo-border-thin) solid var(--duo-border-strong);
    border-radius: var(--duo-radius-md);
    background: var(--duo-bg-cream);
    color: var(--duo-text-primary);
  }

  .servicios__ayuda-pregunta {
    font-size: var(--duo-fs-body-s);
    line-height: 1.6;
  }

  .servicios__ayuda-link {
    display: inline-flex;
    align-items: center;
    gap: var(--duo-space-2);
    padding-block: var(--duo-space-3);
    font-size: var(--duo-fs-button);
    font-weight: 600;
    line-height: 1;
    text-underline-offset: 0.2em;
  }

  .servicios__ayuda:hover .servicios__ayuda-link {
    text-decoration: underline;
  }

  /* ---------- Stickers ---------- */
  .servicios__stickers {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .servicios__stickers-desktop {
    display: none;
  }

  .servicios__stickers-caja {
    position: relative;
  }

  .servicios :global(.servicios__st) {
    position: absolute;
    z-index: 2;
  }

  .servicios :global(.servicios__st--destellos-c) {
    top: 54px;
    right: 50px;
  }

  .servicios :global(.servicios__st--grafico-c) {
    top: 21px;
    left: 148px;
  }

  /* ---------- Tablet (768–1023): grilla 2×2 ---------- */
  @media (min-width: 768px) {
    .servicios__pista {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--duo-grid-gutter);
      max-width: calc(
        var(--duo-container-max) + 2 * var(--duo-container-margin)
      );
      margin-inline: auto;
      overflow: visible;
      scroll-snap-type: none;
    }

    .servicio-card__divisor {
      display: block;
    }

    .servicio-card__de,
    .servicios__indicador {
      display: none;
    }

    .servicios__ayuda {
      padding-inline: var(--duo-space-7);
    }

    .servicios__ayuda-pregunta {
      font-size: var(--duo-fs-body);
    }
  }

  /* ---------- Desktop (≥1024): 4 cards de 3 columnas ---------- */
  @media (min-width: 1024px) {
    .servicios__cuerpo {
      gap: var(--duo-space-8);
    }

    .servicios__encabezado {
      align-items: center;
      gap: var(--duo-space-4);
      text-align: center;
    }

    .servicios__bajada {
      max-width: 560px;
    }

    .servicios__pista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .servicios__pista :global(.servicio-card__cta) {
      padding-inline: var(--duo-space-4);
    }

    .servicios__ayuda {
      flex-direction: row;
      align-items: center;
      gap: var(--duo-space-3);
      width: fit-content;
      margin-inline: auto;
      padding: var(--duo-space-4) var(--duo-space-6);
      border-radius: var(--duo-radius-full);
    }

    .servicios__ayuda-link {
      padding-block: 0;
    }

    .servicios__stickers-desktop {
      position: absolute;
      inset: var(--duo-section-space) 0 auto;
      display: block;
      height: 0;
    }

    .servicios__stickers > :global(.servicios__st--destellos-c),
    .servicios__stickers > :global(.servicios__st--grafico-c) {
      display: none;
    }

    /* Posiciones de Figma: left en % del contenido de 1200px, top desde el
       inicio del contenido (después del padding de 96px). */
    .servicios :global(.servicios__st--destellos) {
      left: 9.47%;
      top: -35px;
    }

    .servicios :global(.servicios__st--grafico) {
      left: 82.9%;
      top: -41px;
    }

    .servicios :global(.servicios__st--corazon) {
      left: 5.4%;
      top: 148px;
    }

    .servicios :global(.servicios__st--burbuja) {
      left: 88.1%;
      top: 117px;
    }
  }
</style>
