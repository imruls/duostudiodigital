---
import { clientReviews as reviews, googleReviewHref } from "@data/dataSite";
import Icon from "@ui/Icon.astro";
---

<section class="section resenas" id="resenas">
  <div class="container">
    <div class="resenas__header reveal">
      <span class="section-label">Reseñas</span>
      <h2 class="section-title">
        Lo que dicen nuestros <span>clientes</span>
      </h2>
      <p class="section-subtitle">
        Historias reales de personas que ya trabajaron con nosotras.
      </p>
    </div>

    <div
      class="resenas__carousel"
      role="region"
      aria-label="Reseñas de clientes"
      aria-roledescription="carousel"
    >
      <button
        class="resenas__arrow resenas__arrow--prev"
        aria-label="Reseña anterior"
      >
        <Icon name="chevron-left" size={20} />
      </button>
      <div class="resenas__track-wrapper">
        <div class="resenas__track">
          {
            reviews.map((r) => (
              <div class="resena-card">
                <span class="resena-card__name">{r.name}</span>
                <div class="resena-card__stars">
                  {Array.from({ length: r.rating }).map(() => (
                    <Icon name="star" size={16} />
                  ))}
                </div>
                <p class="resena-card__text">"{r.text}"</p>
              </div>
            ))
          }
        </div>
      </div>
      <button
        class="resenas__arrow resenas__arrow--next"
        aria-label="Siguiente reseña"
      >
        <Icon name="chevron-right" size={20} />
      </button>
    </div>
    <div class="resenas__dots" aria-hidden="true">
      {
        reviews.map((_, i) => (
          <span class:list={["resenas__dot", { active: i === 0 }]} />
        ))
      }
    </div>

    <div class="resenas__cta-wrap reveal">
      <p class="resenas__cta-text">¿Ya trabajaste con nosotras?</p>
      <a
        href={googleReviewHref}
        target="_blank"
        rel="noopener noreferrer"
        class="resenas__cta"
      >
        Dejanos tu reseña en Google
        <Icon name="star" />
      </a>
    </div>
  </div>
</section>

<script>
  import { initScrollDots } from "@scripts/scrollDots";

  const wrapper = document.querySelector<HTMLElement>(
    ".resenas__track-wrapper",
  );
  const track = document.querySelector<HTMLElement>(".resenas__track");
  const prevBtn = document.querySelector<HTMLButtonElement>(
    ".resenas__arrow--prev",
  );
  const nextBtn = document.querySelector<HTMLButtonElement>(
    ".resenas__arrow--next",
  );

  if (wrapper && track) {
    const cardWidth = 280 + 16; // card width + gap approximation
    const cards = Array.from(
      track.querySelectorAll<HTMLElement>(".resena-card"),
    );
    const dots = Array.from(
      document.querySelectorAll<HTMLElement>(".resenas__dot"),
    );

    initScrollDots({ container: wrapper, items: cards, dots });

    nextBtn?.addEventListener("click", () => {
      wrapper.scrollBy({ left: cardWidth, behavior: "smooth" });
    });

    prevBtn?.addEventListener("click", () => {
      wrapper.scrollBy({ left: -cardWidth, behavior: "smooth" });
    });
  }
</script>

<style>
  .resenas {
    background: linear-gradient(
      to bottom,
      var(--duo-bg-cream),
      var(--duo-bg-page)
    );
  }

  .resenas__header {
    text-align: center;
    margin-bottom: var(--duo-space-9);
  }

  .resenas__header .section-subtitle {
    margin-inline: auto;
  }

  .resenas__carousel {
    display: flex;
    align-items: center;
    gap: var(--duo-space-4);
  }

  .resenas__arrow {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--duo-color-verde-600);
    background: transparent;
    color: var(--duo-text-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--duo-transition);
  }

  .resenas__arrow:hover {
    background: var(--duo-action-secondary-bg);
    color: var(--duo-text-inverse);
  }

  .resenas__track-wrapper {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex: 1;
  }

  .resenas__track-wrapper::-webkit-scrollbar {
    display: none;
  }

  .resenas__track {
    display: flex;
    gap: var(--duo-space-6);
  }

  .resena-card {
    min-width: 280px;
    flex: 0 0 280px;
    scroll-snap-align: start;
    background: var(--duo-bg-page);
    border-radius: var(--duo-radius-md);
    padding: 1.5rem;
    box-shadow: 0 2px 12px
      color-mix(in srgb, var(--duo-color-verde-900) 6%, transparent);
  }

  .resena-card__stars {
    display: flex;
    gap: 2px;
    color: var(--duo-text-primary);
    margin-bottom: 0.75rem;
  }

  .resena-card__text {
    font-size: 0.9rem;
    color: var(--duo-text-primary);
    line-height: 1.6;
    font-style: italic;
  }

  .resena-card__name {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--duo-text-primary);
    margin-bottom: 0.35rem;
  }

  /* Dots indicator */
  .resenas__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--duo-space-6);
  }

  .resenas__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--duo-color-verde-300);
    transition: var(--duo-transition);
  }

  .resenas__dot.active {
    background: var(--duo-action-secondary-bg);
    transform: scale(1.25);
  }

  /* CTA para dejar reseña en Google */
  .resenas__cta-wrap {
    margin-top: var(--duo-space-9);
    text-align: center;
  }

  .resenas__cta-text {
    font-size: 0.95rem;
    color: var(--duo-text-primary);
    margin-bottom: var(--duo-space-4);
  }

  .resenas__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    background: var(--duo-action-secondary-bg);
    color: var(--duo-text-inverse);
    border-radius: var(--duo-radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    transition: var(--duo-transition);
    box-shadow: 0 4px 20px
      color-mix(in srgb, var(--duo-color-verde-700) 30%, transparent);
  }

  .resenas__cta:hover {
    background: var(--duo-color-verde-800);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px
      color-mix(in srgb, var(--duo-color-verde-700) 40%, transparent);
  }

  /* Mobile: hide arrows, rely on swipe + dots */
  @media (max-width: 639px) {
    .resenas__arrow {
      display: none;
    }
  }

  /* Desktop: hide dots */
  @media (min-width: 640px) {
    .resenas__dots {
      display: none;
    }
  }
</style>
