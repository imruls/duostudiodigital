---
/**
 * Contacto — Figma: desktop 23:333 · tablet 54:2688 · mobile 27:640.
 * Nota de cumplimiento: "Nota/Contacto".
 * - 4 cards de 3 columnas en desktop, 2×2 en tablet, apiladas en mobile.
 * - WhatsApp destacado en rosa como canal recomendado.
 * - La card completa es el link y cada canal explica qué esperar.
 * - Desktop: email visible (para copiar) y ubicación debajo de las cards.
 */
import BadgeSection from "@ui/BadgeSection.astro";
import ContactCard from "@ui/ContactCard.astro";
import Sticker from "@ui/Sticker.astro";
import Icon from "@ui/Icon.astro";
import {
  contactoSeccion as c,
  contactChannels,
  contactEmail,
  contactEmailUrl,
  ubicacion,
} from "@data/dataSite";
---

<section
  class="section contacto"
  id="contacto"
  aria-labelledby="contacto-titulo"
>
  <div class="contacto__stickers" aria-hidden="true">
    <div class="container contacto__stickers-desktop">
      <div class="contacto__stickers-caja">
        <Sticker
          tipo="burbuja"
          tamano={67.2}
          rotacion={8}
          class="contacto__st contacto__st--burbuja"
        />
        <Sticker
          tipo="corazon"
          tamano={61.6}
          rotacion={-10}
          class="contacto__st contacto__st--corazon"
        />
        <Sticker
          tipo="destellos"
          tamano={56}
          rotacion={6}
          class="contacto__st contacto__st--destellos"
        />
        <Sticker
          tipo="cursor"
          tamano={56}
          rotacion={-12}
          class="contacto__st contacto__st--cursor"
        />
      </div>
    </div>
    <Sticker
      tipo="burbuja"
      tamano={39.2}
      rotacion={8}
      class="contacto__st contacto__st--burbuja-c"
    />
    <Sticker
      tipo="corazon"
      tamano={33.6}
      rotacion={-10}
      class="contacto__st contacto__st--corazon-c"
    />
  </div>

  <div class="container contacto__cuerpo">
    <header class="contacto__encabezado">
      <BadgeSection tono="rosa">{c.badge}</BadgeSection>
      <h2 class="section-title contacto__titulo" id="contacto-titulo">
        {c.titulo.antes}<span>{c.titulo.destacado}</span>
      </h2>
      <p class="contacto__bajada">{c.bajada}</p>
    </header>

    <ul class="contacto__canales">
      {
        contactChannels.map((canal) => (
          <li class="contacto__canal">
            <ContactCard
              href={canal.href}
              canal={canal.name}
              descripcion={canal.description}
              icono={canal.icon}
              externo={canal.externo}
              destacada={canal.destacado}
            />
          </li>
        ))
      }
    </ul>

    <ul class="contacto__datos">
      <li class="contacto__dato">
        <Icon name="mail" size={18} />
        <a class="contacto__email" href={contactEmailUrl}>{contactEmail}</a>
      </li>
      <li class="contacto__dato">
        <Icon name="pin" size={18} />
        <span>{ubicacion}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  /* ---------- Sección (mobile first) ---------- */
  .contacto {
    --duo-focus-color: var(--duo-border-focus-inverse);
    background: var(--duo-bg-hero);
    color: var(--duo-text-inverse);
  }

  .contacto__cuerpo {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--duo-space-6);
  }

  .contacto__encabezado {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--duo-space-6);
  }

  .contacto__titulo {
    color: var(--duo-text-inverse);
  }

  .contacto__titulo span {
    color: var(--duo-text-highlight);
  }

  .contacto__bajada {
    font-size: var(--duo-fs-body);
    line-height: 1.6;
  }

  /* ---------- Canales ---------- */
  .contacto__canales {
    display: grid;
    gap: var(--duo-space-4);
    list-style: none;
  }

  .contacto__canal {
    display: flex;
  }

  .contacto__canal :global(.card-contacto) {
    width: 100%;
  }

  /* Email y ubicación: solo desktop (Figma) */
  .contacto__datos {
    display: none;
    list-style: none;
  }

  /* ---------- Stickers ---------- */
  .contacto__stickers {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .contacto__stickers-desktop {
    display: none;
  }

  .contacto__stickers-caja {
    position: relative;
  }

  .contacto :global(.contacto__st) {
    position: absolute;
  }

  .contacto :global(.contacto__st--burbuja-c) {
    top: 50px;
    right: 51px;
  }

  .contacto :global(.contacto__st--corazon-c) {
    top: 24px;
    right: 106px;
  }

  /* ---------- Tablet (768–1023): 2×2 ---------- */
  @media (min-width: 768px) {
    .contacto__canales {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--duo-grid-gutter);
    }
  }

  /* ---------- Desktop (≥1024): 4 cards de 3 columnas ---------- */
  @media (min-width: 1024px) {
    .contacto__cuerpo {
      gap: var(--duo-space-8);
    }

    .contacto__encabezado {
      align-items: center;
      gap: var(--duo-space-4);
      text-align: center;
    }

    .contacto__titulo {
      max-width: 800px;
    }

    .contacto__bajada {
      max-width: 560px;
    }

    .contacto__canales {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .contacto__datos {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--duo-space-6);
      font-size: var(--duo-fs-body-s);
      line-height: 1.6;
    }

    .contacto__dato {
      display: inline-flex;
      align-items: center;
      gap: var(--duo-space-2);
    }

    .contacto__dato :global(svg) {
      color: var(--duo-text-highlight);
    }

    /* Área táctil de 44px (CLAUDE.md) */
    .contacto__email {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-underline-offset: 0.2em;
    }

    .contacto__email:hover {
      text-decoration: underline;
    }

    .contacto__stickers-desktop {
      position: absolute;
      inset: var(--duo-section-space) 0 auto;
      display: block;
      height: 0;
    }

    .contacto__stickers > :global(.contacto__st--burbuja-c),
    .contacto__stickers > :global(.contacto__st--corazon-c) {
      display: none;
    }

    .contacto :global(.contacto__st--burbuja) {
      left: 19.85%;
      top: -12px;
    }

    .contacto :global(.contacto__st--corazon) {
      left: 76.2%;
      top: -32px;
    }

    .contacto :global(.contacto__st--destellos) {
      left: 98.9%;
      top: 77px;
    }

    .contacto :global(.contacto__st--cursor) {
      left: -3.73%;
      top: 48px;
    }
  }
</style>
