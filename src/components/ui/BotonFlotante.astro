---
/**
 * BotonFlotante — componente "Boton flotante WhatsApp" de Figma (52:2460).
 * Pedido del cliente: se mantiene siempre en la página.
 * Desktop (≥1024): pill "Escribinos" + círculo rosa con WhatsApp.
 * Tablet/mobile: círculo de 60px solo con ícono (aria-label).
 * Fijo abajo a la derecha con 24px de margen.
 * Foco: outline 3px verde/900 + box-shadow 0 0 0 6px rosa (se ve sobre
 * cualquier fondo).
 * Se oculta (opacity 0 + visibility hidden, 200ms) cuando el footer entra en
 * pantalla, para no tapar los links de redes (IntersectionObserver).
 */
import Icon from "@ui/Icon.astro";
import {
  whatsappUrl as defaultWhatsappUrl,
  whatsappCta,
  externalLinkHint,
} from "@data/dataSite";

interface Props {
  whatsappUrl?: string;
}

const { whatsappUrl = defaultWhatsappUrl } = Astro.props;
---

<aside class="boton-flotante-region" aria-label={whatsappCta.regionLabel}>
  <a
    href={whatsappUrl}
    class="boton-flotante"
    aria-label={`${whatsappCta.ariaLabel} ${externalLinkHint}`}
    target="_blank"
    rel="noopener noreferrer"
    data-boton-flotante
  >
    <span class="boton-flotante__texto">{whatsappCta.label}</span>
    <span class="boton-flotante__circulo">
      <Icon name="whatsapp" size={22} />
    </span>
    <span class="boton-flotante__icono-mobile">
      <Icon name="whatsapp" size={28} />
    </span>
  </a>
</aside>

<script>
  const boton = document.querySelector<HTMLElement>("[data-boton-flotante]");
  const footer = document.querySelector<HTMLElement>("[data-footer]");

  if (boton && footer && "IntersectionObserver" in window) {
    const botonEl = boton;
    new IntersectionObserver(([entrada]) => {
      botonEl.toggleAttribute("data-oculto", Boolean(entrada?.isIntersecting));
    }).observe(footer);
  }
</script>

<style>
  .boton-flotante {
    position: fixed;
    right: var(--duo-space-6);
    bottom: calc(var(--duo-space-6) + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: var(--duo-border-thick) solid var(--duo-border-strong);
    border-radius: var(--duo-radius-full);
    background: var(--duo-bg-hero);
    color: var(--duo-text-inverse);
    box-shadow: var(--duo-shadow-toggle);
    transition:
      background-color var(--duo-transition),
      box-shadow var(--duo-transition),
      transform var(--duo-transition),
      opacity var(--duo-transition-lenta),
      visibility 0s;
  }

  /* Footer visible: se desvanece y sale del orden de tabulación. La
     visibilidad cambia al final del fundido para que se vea la transición. */
  .boton-flotante[data-oculto] {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duo-transition-lenta),
      visibility 0s linear 200ms;
  }

  .boton-flotante:hover {
    background: var(--duo-bg-hover-inverse);
    box-shadow: var(--duo-shadow-hover);
    transform: var(--duo-hover-translate);
  }

  .boton-flotante:active {
    box-shadow: none;
    transform: none;
  }

  .boton-flotante:focus-visible {
    outline: var(--duo-focus-ring-thin) solid var(--duo-border-focus);
    box-shadow: 0 0 0 6px var(--duo-border-focus-inverse);
  }

  .boton-flotante__texto,
  .boton-flotante__circulo {
    display: none;
  }

  .boton-flotante__icono-mobile {
    display: inline-flex;
  }

  @media (min-width: 1024px) {
    .boton-flotante {
      gap: var(--duo-space-3);
      width: auto;
      height: auto;
      padding: var(--duo-space-3) var(--duo-space-3) var(--duo-space-3)
        var(--duo-space-5);
    }

    .boton-flotante__texto {
      display: inline;
      font-size: var(--duo-fs-button);
      font-weight: 600;
      line-height: 1;
    }

    .boton-flotante__circulo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: var(--duo-radius-full);
      background: var(--duo-action-primary-bg);
      color: var(--duo-action-primary-text);
    }

    .boton-flotante__icono-mobile {
      display: none;
    }
  }
</style>
