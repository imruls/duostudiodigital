---
import {
  whatsappUrl as defaultWhatsappUrl,
  whatsappIconSvg,
} from "@data/dataSite";

interface Props {
  whatsappUrl?: string;
}

const { whatsappUrl = defaultWhatsappUrl } = Astro.props;
---

<!-- WhatsApp -->
<a
  href={whatsappUrl}
  class="whatsapp-btn"
  aria-label="Contactar por WhatsApp"
  target="_blank"
  rel="noopener noreferrer"
>
  <Fragment set:html={whatsappIconSvg} />
</a>

<style>
  .whatsapp-btn {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--duo-action-primary-bg);
    color: var(--duo-action-primary-text);
    border: var(--duo-border-thick) solid var(--duo-border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--duo-shadow-cta);
    transition: var(--duo-transition);
    z-index: 90;
  }

  .whatsapp-btn:hover {
    background: var(--duo-action-primary-bg-hover);
    transform: var(--duo-hover-translate);
    box-shadow: var(--duo-shadow-hover);
  }

  .whatsapp-btn svg {
    width: 26px;
    height: 26px;
  }
</style>
