---
/**
 * Icon — íconos del tablero "Iconos" de Figma (node 17:5).
 * Los SVG viven en src/assets/icons/ tal cual se exportaron de Figma; acá
 * solo se reemplaza el color fijo (#2C321D / #F8D0D8) por currentColor para
 * que cada instancia tome el color del texto, como indica Figma
 * ("Sobrescribir color en la instancia según el fondo").
 * Decorativos por defecto (aria-hidden); el texto accesible va en el control.
 */
import type { IconName } from "./iconTypes";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const sources = import.meta.glob<string>("../../assets/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const raw = sources[`../../assets/icons/${name}.svg`];
if (!raw) throw new Error(`Icon: no existe src/assets/icons/${name}.svg`);

const svg = raw
  .replace(/#2C321D|#F8D0D8/gi, "currentColor")
  .replace(/\s(preserveAspectRatio|overflow|style)="[^"]*"/g, "")
  .replace(/\swidth="[^"]*"/, ` width="${size}"`)
  .replace(/\sheight="[^"]*"/, ` height="${size}"`)
  .replace(
    "<svg",
    `<svg aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ""}`,
  );
---

<Fragment set:html={svg} />
