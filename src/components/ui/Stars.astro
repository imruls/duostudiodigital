---
/**
 * Stars — componente "Estrellas" de Figma (node 17:133).
 * Siempre acompañado de texto ("5 de 5"); las estrellas son decorativas.
 */
import Icon from "@ui/Icon.astro";
import { ratingLabel } from "@data/dataSite";

interface Props {
  rating?: number;
  max?: number;
  mostrarTexto?: boolean;
  class?: string;
}

const {
  rating = 5,
  max = 5,
  mostrarTexto = true,
  class: className,
} = Astro.props;
const label = ratingLabel(rating, max);
---

<span class:list={["estrellas", className]}>
  <span class="estrellas__iconos" aria-hidden="true">
    {
      Array.from({ length: max }).map((_, i) => (
        <Icon
          name="star"
          size={18}
          class={i < rating ? "estrellas__llena" : "estrellas__vacia"}
        />
      ))
    }
  </span>
  <span class:list={[mostrarTexto ? "estrellas__texto" : "sr-only"]}>
    {label}
  </span>
</span>

<style>
  .estrellas {
    display: inline-flex;
    align-items: center;
    gap: var(--duo-space-2);
  }

  .estrellas__iconos {
    display: inline-flex;
    gap: var(--duo-space-1);
    color: var(--duo-text-accent);
  }

  .estrellas__iconos :global(.estrellas__vacia) {
    opacity: 0.3;
  }

  .estrellas__texto {
    font-size: var(--duo-fs-caption);
    line-height: 1.5;
    color: var(--duo-text-secondary);
  }
</style>
