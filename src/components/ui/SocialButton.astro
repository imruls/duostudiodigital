---
/**
 * SocialButton — componente "Social" de Figma (node 52:2435).
 * Círculo de 48px con ícono de la red. aria-label "Instagram de Dúo" +
 * "(se abre en otra pestaña)". Va sobre fondo verde: foco rosa.
 */
import Icon from "@ui/Icon.astro";
import type { IconName } from "@ui/iconTypes";
import { externalLinkHint } from "@data/dataSite";

interface Props {
  href: string;
  icono: IconName;
  label: string;
  externo?: boolean;
  class?: string;
}

const { href, icono, label, externo = true, class: className } = Astro.props;
---

<a
  class:list={["social", className]}
  href={href}
  aria-label={externo ? `${label} ${externalLinkHint}` : label}
  target={externo ? "_blank" : undefined}
  rel={externo ? "noopener noreferrer" : undefined}
>
  <Icon name={icono} size={22} />
</a>

<style>
  .social {
    --duo-focus-color: var(--duo-border-focus-inverse);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: var(--duo-border-thick) solid var(--duo-border-strong);
    border-radius: var(--duo-radius-full);
    background: var(--duo-action-primary-bg);
    color: var(--duo-action-primary-text);
    box-shadow: var(--duo-shadow-badge);
    transition:
      box-shadow var(--duo-transition),
      transform var(--duo-transition);
  }

  .social:hover {
    box-shadow: var(--duo-shadow-hover);
    transform: var(--duo-hover-translate);
  }

  .social:active {
    box-shadow: none;
    transform: none;
  }
</style>
